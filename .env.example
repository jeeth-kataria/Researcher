# Local SQLite file; no database server, Docker or cloud database is required.
RGI_DATABASE_PATH=.data/researcher.sqlite3
RGI_STORAGE_DIR=.data
RGI_READ_ONLY=false
RGI_OWNER_TOKEN=
RGI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RGI_PARSER=docling
RGI_EMBEDDER=bge
# Primary provider. Keys stay server-side; never use VITE_ variables for them.
RGI_GROQ_API_KEY=
RGI_GROQ_MODEL=openai/gpt-oss-120b
# Set true only after checking your selected provider's free plan, billing and quotas.
RGI_FREE_TIER_ACK=false
# Secondary provider, only used when explicitly selected.
RGI_GEMINI_API_KEY=
RGI_GEMINI_MODEL=gemini-2.5-flash
RGI_MAX_UPLOAD_MB=20
RGI_MAX_PAPERS=50
# Explicit synthetic fixture pipeline (no model downloads / API quota):
# RGI_PARSER=pypdf
# RGI_EMBEDDER=fixture
