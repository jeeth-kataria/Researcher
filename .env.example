RGI_DATABASE_URL=postgresql://rgi:rgi@127.0.0.1:5433/rgi
RGI_STORAGE_DIR=.data
RGI_READ_ONLY=false
RGI_OWNER_TOKEN=
RGI_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
RGI_PARSER=docling
RGI_EMBEDDER=bge
RGI_GEMINI_API_KEY=
RGI_GEMINI_MODEL=gemini-2.5-flash
# Set true only after checking AI Studio: Free tier, billing disabled, active model quota.
RGI_FREE_TIER_ACK=false
RGI_MAX_UPLOAD_MB=20
RGI_MAX_PAPERS=50
