# Local/optional API packaging only. No worker extras or model weights in this image.
FROM python:3.12-slim-bookworm
COPY --from=ghcr.io/astral-sh/uv:0.11.6 /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY backend ./backend
RUN uv sync --locked --no-dev
COPY scripts/init_db.py ./scripts/init_db.py
EXPOSE 8000
# Loopback default. A reviewed hosted deployment can explicitly override host/port.
CMD ["uv", "run", "--no-sync", "uvicorn", "rgi.api:app", "--host", "127.0.0.1", "--port", "8000"]
